# Dependencies
node_modules

# Build outputs (we rebuild in Docker)
.output
.nitro
.tanstack
.vinxi
dist

# Development files
.git
# NOTE: keep .gitignore in the build context. Tailwind v4 uses it to decide
# which files to scan for classes; without it the server build also scans the
# client output in .output/, produces different CSS, and links a stylesheet
# hash that doesn't exist in production (unstyled site).
.vscode
.cursor
*.log

# Database files (we create fresh in production)
*.db
*.db-journal
prisma/data

# Environment files (set via Coolify/Docker)
.env
.env.*
!.env.example

# IDE and OS files
.DS_Store
*.local

# Documentation
README.md
CLAUDE.md
todos.json
